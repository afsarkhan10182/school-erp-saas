<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Alert - Student Absent</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }
        .content {
            padding: 30px;
        }
        .alert-box {
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 5px solid #dc3545;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin: 25px 0;
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
        }
        .info-item {
            display: flex;
            flex-direction: column;
        }
        .info-label {
            font-weight: bold;
            color: #495057;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }
        .info-value {
            color: #212529;
            font-size: 14px;
        }
        .action-section {
            background-color: #e9f4ff;
            border-radius: 8px;
            padding: 20px;
            margin: 25px 0;
            border-left: 5px solid #007bff;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #6c757d;
            border-top: 1px solid #e9ecef;
        }
        .contact-info {
            margin: 15px 0;
            padding: 15px;
            background-color: #f8f9fa;
            border-radius: 8px;
        }
        @media (max-width: 600px) {
            .info-grid {
                grid-template-columns: 1fr;
            }
            .container {
                margin: 10px;
            }
            .header, .content {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🚨 Student Absence Alert</h1>
            <p style="margin: 10px 0 0 0; opacity: 0.9;">Attendance Notification</p>
        </div>
        
        <div class="content">
            <p>Dear <strong><%= parentName %></strong>,</p>
            
            <div class="alert-box">
                <h3 style="margin: 0 0 10px 0; color: #721c24;">
                    <strong><%= studentName %></strong> was marked <strong>ABSENT</strong> today
                </h3>
                <p style="margin: 0; font-size: 14px;">
                    Please review the attendance details below and contact the school if there are any discrepancies.
                </p>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Student Name</span>
                    <span class="info-value"><%= studentName %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Student ID</span>
                    <span class="info-value"><%= studentId %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Class</span>
                    <span class="info-value"><%= className %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Section</span>
                    <span class="info-value"><%= sectionName %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Date</span>
                    <span class="info-value"><%= new Date(date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Attendance Type</span>
                    <span class="info-value">
                        <%= attendanceType === 'daily' ? 'Full Day' : `Period ${periodNumber}` %>
                    </span>
                </div>
            </div>

            <% if (remarks) { %>
            <div style="margin: 20px 0; padding: 15px; background-color: #fff3cd; border-radius: 8px; border-left: 5px solid #ffc107;">
                <strong>Additional Notes:</strong><br>
                <%= remarks %>
            </div>
            <% } %>

            <div class="action-section">
                <h4 style="margin: 0 0 15px 0; color: #004085;">📋 What to do next:</h4>
                <ul style="margin: 0; padding-left: 20px;">
                    <li>If your child was absent due to illness or emergency, please inform the school</li>
                    <li>Provide a written excuse/medical certificate if required</li>
                    <li>Contact the class teacher for any missed assignments or announcements</li>
                    <li>If this absence marking is incorrect, please contact the school immediately</li>
                </ul>
            </div>

            <div class="contact-info">
                <h4 style="margin: 0 0 10px 0;">📞 School Contact Information</h4>
                <p style="margin: 5px 0;"><strong>School:</strong> <%= schoolName %></p>
                <% if (schoolPhone && schoolPhone !== 'N/A') { %>
                <p style="margin: 5px 0;"><strong>Phone:</strong> <%= schoolPhone %></p>
                <% } %>
                <% if (schoolEmail && schoolEmail !== 'school@example.com') { %>
                <p style="margin: 5px 0;"><strong>Email:</strong> <%= schoolEmail %></p>
                <% } %>
            </div>

            <p style="margin-top: 25px; font-size: 14px; color: #6c757d;">
                This is an automated notification. Please do not reply to this email directly.
                For any concerns, please contact the school using the information provided above.
            </p>
        </div>

        <div class="footer">
            <p>&copy; <%= new Date().getFullYear() %> <%= schoolName %>. All rights reserved.</p>
            <p>Generated on <%= new Date().toLocaleString() %></p>
        </div>
    </div>
</body>
</html>