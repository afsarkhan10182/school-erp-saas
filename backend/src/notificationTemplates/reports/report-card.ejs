<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report Card - <%= student.first_name %> <%= student.last_name %></title>
    <style>
        /* Professional Print Styles */
        @media print {
            @page {
                size: A4 portrait;
                margin: 1cm;
            }
            
            body {
                font-family: 'Georgia', 'Times New Roman', serif;
                font-size: 10pt;
                line-height: 1.3;
                color: #2c3e50;
                background: white;
                margin: 0;
                padding: 0;
            }
            
            .no-print { display: none !important; }
            .page-break { page-break-before: always; }
            .keep-together { page-break-inside: avoid; }
            
            table { 
                page-break-inside: auto;
                border-collapse: collapse;
            }
            
            tr { page-break-inside: avoid; }
            
            .data-table th {
                background: #f8f9fa !important;
                color: #2c3e50 !important;
                border: 1pt solid #dee2e6 !important;
            }
            
            .data-table td {
                border: 1pt solid #dee2e6 !important;
                background: white !important;
            }
            
            .data-table tr:nth-child(even) {
                background: #f8f9fa !important;
            }
        }
        
        /* Screen styles - Clean and professional design */
        body {
            font-family: 'Georgia', 'Times New Roman', serif;
            font-size: 10pt;
            line-height: 1.3;
            color: #2c3e50;
            background: #f8f9fa;
            margin: 0;
            padding: 15px;
        }
        
        .report-container {
            max-width: 210mm;
            margin: 0 auto;
            background: white;
            min-height: auto;
            padding: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border-radius: 8px;
        }
        
        /* Professional Report Header */
        .report-header {
            text-align: center;
            padding: 15pt 0;
            border-bottom: 1pt solid #34495e;
            margin-bottom: 15pt;
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
            border-radius: 6pt;
        }
        
        .school-name {
            font-size: 16pt;
            font-weight: bold;
            margin-bottom: 4pt;
            color: #2c3e50;
            text-transform: uppercase;
            letter-spacing: 1pt;
            font-family: 'Georgia', serif;
        }
        
        .report-title {
            font-size: 14pt;
            font-weight: bold;
            margin-bottom: 4pt;
            color: #34495e;
            font-family: 'Georgia', serif;
        }
        
        .report-date {
            font-size: 9pt;
            color: #6c757d;
            font-style: italic;
            font-family: 'Georgia', serif;
        }
        
        /* Student Information Section */
        .student-info {
            margin: 15pt 0;
            padding: 12pt;
            border: 1pt solid #dee2e6;
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
            border-radius: 6pt;
            box-shadow: 0 2pt 8pt rgba(0,0,0,0.06);
        }
        
        .student-info h3 {
            margin: 0 0 10pt 0;
            font-size: 11pt;
            color: #2c3e50;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
        }
        
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8pt;
        }
        
        .info-item {
            display: flex;
            align-items: center;
        }
        
        .info-label {
            font-weight: bold;
            min-width: 80pt;
            font-size: 9pt;
            color: #6c757d;
        }
        
        .info-value {
            font-size: 9pt;
            color: #2c3e50;
        }
        
        /* Summary Section */
        .summary-section {
            margin: 15pt 0;
            padding: 12pt;
            border: 1pt solid #dee2e6;
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
            border-radius: 6pt;
            box-shadow: 0 2pt 8pt rgba(0,0,0,0.06);
        }
        
        .summary-section h3 {
            margin: 0 0 10pt 0;
            font-size: 11pt;
            color: #2c3e50;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
        }
        
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12pt;
        }
        
        .summary-card {
            text-align: center;
            padding: 10pt;
            border: 1pt solid #dee2e6;
            background: white;
            border-radius: 6pt;
            box-shadow: 0 1pt 4pt rgba(0,0,0,0.04);
            transition: all 0.3s ease;
        }
        
        .summary-card:hover {
            transform: translateY(-3pt);
            box-shadow: 0 4pt 16pt rgba(0,0,0,0.12);
        }
        
        .summary-value {
            font-size: 14pt;
            font-weight: bold;
            margin-bottom: 4pt;
            color: #27ae60;
            font-family: 'Georgia', serif;
        }
        
        .summary-label {
            font-size: 8pt;
            text-transform: uppercase;
            font-weight: bold;
            color: #6c757d;
            letter-spacing: 0.5pt;
            font-family: 'Georgia', serif;
        }
        
        /* Professional Data Table */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15pt 0;
            font-size: 9pt;
            border-radius: 6pt;
            overflow: hidden;
            box-shadow: 0 2pt 8pt rgba(0,0,0,0.06);
            font-family: 'Georgia', serif;
        }
        
        .data-table th {
            background: #f8f9fa;
            color: #2c3e50;
            padding: 8pt 6pt;
            text-align: left;
            font-weight: bold;
            border: 1pt solid #dee2e6;
            font-size: 9pt;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
            font-family: 'Georgia', serif;
        }
        
        .data-table td {
            padding: 6pt 4pt;
            border: 1pt solid #dee2e6;
            vertical-align: top;
            font-size: 9pt;
            background: white;
            font-family: 'Georgia', serif;
        }
        
        .data-table tr {
            background: white;
            transition: background-color 0.2s ease;
        }
        
        .data-table tr:nth-child(even) {
            background: #f8f9fa;
        }
        
        .data-table tr:hover {
            background: #e9ecef;
        }
        
        /* Subject Analysis Section */
        .subject-analysis {
            margin: 15pt 0;
        }
        
        .subject-analysis h3 {
            margin: 0 0 10pt 0;
            font-size: 11pt;
            color: #2c3e50;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
        }
        
        .subject-card {
            border: 1pt solid #dee2e6;
            margin-bottom: 8pt;
            border-radius: 4pt;
            overflow: hidden;
        }
        
        .subject-header {
            background: #f8f9fa;
            padding: 6pt 8pt;
            border-bottom: 1pt solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .subject-name {
            font-weight: bold;
            font-size: 10pt;
            color: #2c3e50;
        }
        
        .subject-stats {
            display: flex;
            gap: 12pt;
            font-size: 8pt;
            color: #6c757d;
        }
        
        .subject-content {
            padding: 8pt;
        }
        
        .subject-table {
            width: 100%;
            font-size: 8pt;
            border-collapse: collapse;
        }
        
        .subject-table th,
        .subject-table td {
            padding: 4pt 6pt;
            border: 1pt solid #dee2e6;
            text-align: left;
        }
        
        .subject-table th {
            background: #f8f9fa;
            font-weight: bold;
            font-size: 8pt;
        }
        
        /* Remarks Section */
        .remarks-section {
            margin: 15pt 0;
            padding: 12pt;
            border: 1pt solid #dee2e6;
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
            border-radius: 6pt;
        }
        
        .remarks-section h3 {
            margin: 0 0 10pt 0;
            font-size: 11pt;
            color: #2c3e50;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
        }
        
        .remark-item {
            margin-bottom: 8pt;
            padding: 8pt;
            background: white;
            border-left: 4pt solid #2563eb;
            border-radius: 4pt;
            font-size: 9pt;
            line-height: 1.4;
        }
        
        /* Footer */
        .report-footer {
            margin-top: 15pt;
            text-align: center;
            font-size: 8pt;
            color: #6c757d;
            border-top: 1pt solid #dee2e6;
            padding-top: 8pt;
            background: linear-gradient(to right, #f8f9fa, #ffffff, #f8f9fa);
            border-radius: 4pt;
            font-family: 'Georgia', serif;
        }
        
        /* Print Preview Controls */
        .preview-controls {
            position: fixed;
            top: 20px;
            right: 20px;
            background: white;
            padding: 20px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            z-index: 1000;
            font-family: 'Georgia', serif;
        }
        
        .preview-controls button {
            margin: 0 8px;
            padding: 10px 20px;
            border: 1px solid #dee2e6;
            background: #f8f9fa;
            cursor: pointer;
            border-radius: 6px;
            font-size: 12px;
            font-family: 'Georgia', serif;
            transition: all 0.2s ease;
        }
        
        .preview-controls button:hover {
            background: #e9ecef;
            transform: translateY(-1px);
        }
        
        .preview-controls button.primary {
            background: #007bff;
            color: white;
            border-color: #007bff;
        }
        
        .preview-controls button.primary:hover {
            background: #0056b3;
        }
        
        .preview-controls button.success {
            background: #28a745;
            color: white;
            border-color: #28a745;
        }
        
        .preview-controls button.success:hover {
            background: #1e7e34;
        }
    </style>
</head>
<body>
    <% if (!autoPrint) { %>
    <!-- Print Preview Controls -->
    <div class="preview-controls no-print">
        <button onclick="window.print()" class="primary">Print Report</button>
        <button onclick="window.print()" class="success">Save as PDF</button>
        <button onclick="window.close()">Close</button>
    </div>
    <% } %>
    
    <div class="report-container">
        <!-- Report Header -->
        <div class="report-header">
            <div class="school-name"><%= student.school.name %></div>
            <div class="report-title">Student Report Card</div>
            <div class="report-date">Academic Year: <%= academic_year %> | Generated on: <%= new Date(generated_at).toLocaleDateString() %></div>
        </div>

        <!-- Student Information -->
        <div class="student-info">
            <h3>Student Information</h3>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Name:</span>
                    <span class="info-value"><%= student.first_name %> <%= student.last_name %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Admission No:</span>
                    <span class="info-value"><%= student.admission_number %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Class:</span>
                    <span class="info-value"><%= student.class.name %><%= student.sectionInfo ? ' - ' + student.sectionInfo.name : '' %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Roll Number:</span>
                    <span class="info-value"><%= student.roll_number || 'N/A' %></span>
                </div>
            </div>
        </div>

        <!-- Performance Summary -->
        <div class="summary-section">
            <h3>Performance Summary</h3>
            <div class="summary-grid">
                <div class="summary-card">
                    <div class="summary-value"><%= performance.average_percentage.toFixed(2) %>%</div>
                    <div class="summary-label">Average Percentage</div>
                </div>
                <div class="summary-card">
                    <div class="summary-value"><%= performance.average_gpa.toFixed(2) %></div>
                    <div class="summary-label">Average GPA</div>
                </div>
                <div class="summary-card">
                    <div class="summary-value"><%= performance.attended_exams %>/<%= performance.total_exams %></div>
                    <div class="summary-label">Exams Attended</div>
                </div>
                <div class="summary-card">
                    <div class="summary-value"><%= performance.overall_grade %></div>
                    <div class="summary-label">Overall Grade</div>
                </div>
            </div>
        </div>

        <!-- Exam Results Table -->
        <table class="data-table">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Exam</th>
                    <th>Marks Obtained</th>
                    <th>Max Marks</th>
                    <th>Percentage</th>
                    <th>Grade</th>
                    <th>Rank</th>
                </tr>
            </thead>
            <tbody>
                <% results.forEach(function(result) { %>
                <tr>
                    <td><%= result.subject_name %></td>
                    <td><%= result.exam_name %></td>
                    <td><%= result.marks_obtained %></td>
                    <td><%= result.max_marks %></td>
                    <td><%= result.percentage.toFixed(2) %>%</td>
                    <td><%= result.grade || '-' %></td>
                    <td><%= result.rank || '-' %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <!-- Subject Analysis -->
        <% if (Object.keys(subject_analysis).length > 0) { %>
        <div class="subject-analysis">
            <h3>Subject-wise Analysis</h3>
            <% Object.values(subject_analysis).forEach(function(subject) { %>
            <div class="subject-card">
                <div class="subject-header">
                    <div class="subject-name"><%= subject.subject_name %> (<%= subject.subject_code %>)</div>
                    <div class="subject-stats">
                        <span>Avg: <%= subject.average_percentage.toFixed(2) %>%</span>
                        <span>Trend: <%= subject.performance_trend %></span>
                        <span>Exams: <%= subject.exams.length %></span>
                    </div>
                </div>
                <div class="subject-content">
                    <table class="subject-table">
                        <thead>
                            <tr>
                                <th>Exam</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Marks</th>
                                <th>Percentage</th>
                                <th>Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% subject.exams.forEach(function(exam) { %>
                            <tr>
                                <td><%= exam.exam_name %></td>
                                <td><%= exam.exam_type %></td>
                                <td><%= new Date(exam.exam_date).toLocaleDateString() %></td>
                                <td><%= exam.marks_obtained %>/<%= exam.max_marks %></td>
                                <td><%= exam.percentage.toFixed(2) %>%</td>
                                <td><%= exam.grade || '-' %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% }); %>
        </div>
        <% } %>

        <!-- Remarks -->
        <% if (remarks && remarks.length > 0) { %>
        <div class="remarks-section">
            <h3>Remarks</h3>
            <% remarks.forEach(function(remark) { %>
            <div class="remark-item">• <%= remark %></div>
            <% }); %>
        </div>
        <% } %>

        <!-- Footer -->
        <div class="report-footer">
            <p>This report card is computer generated and does not require a signature.</p>
            <p>Generated on: <%= new Date(generated_at).toLocaleDateString() %> at <%= new Date(generated_at).toLocaleTimeString() %></p>
        </div>
    </div>
</body>
</html>

