# Server Configuration
NODE_ENV=development
PORT=8000
API_PREFIX=/api

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=school_user
DB_PASSWORD=school_erp_user
DB_NAME=school_erp
DB_SSL=false

# JWT Configuration
JWT_SECRET=school_erp_jwt_secret_key_2024_very_secure_key_for_development
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=school_erp_refresh_token_secret_key_2024_very_secure_key_for_development
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# Email Configuration (for future use)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM='School ERP <noreply@example.com>'

# File Uploads (for future use)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880 # 5MB

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100 # limit each IP to 100 requests per windowMs

