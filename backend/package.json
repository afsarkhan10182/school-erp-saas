{
  "name": "school-erp-saas-backend",
  "version": "1.0.0",
  "description": "Backend for School ERP SaaS application",
  "main": "src/server.js",
  "type": "commonjs",
  "_moduleAliases": {
    "~": "src"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "npx sequelize-cli db:migrate --config src/config/cli-config.js",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo --config src/config/cli-config.js",
    "db:seed": "npx sequelize-cli db:seed:all --config src/config/cli-config.js",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all --config src/config/cli-config.js",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:middleware": "node test-middleware-robustness.js",
    "prepare": "echo 'Ready to use project'"
  },
  "keywords": [
    "school",
    "erp",
    "saas",
    "education",
    "management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "papaparse": "^5.4.1",
    "dotenv": "^17.1.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.15.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "redis": "^5.8.2",
    "sequelize": "^6.37.7",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "prettier": "^3.6.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
